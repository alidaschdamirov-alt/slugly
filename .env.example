# Clerk (Dashboard -> API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# MySQL: use either DATABASE_URL or the individual DB_* values.
DATABASE_URL=mysql://slugly:slugly@127.0.0.1:3306/slugly
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=slugly
# DB_USER=slugly
# DB_PASSWORD=slugly

# The first matching Clerk user becomes a Slugly administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Optional comma-separated additional protected administrators.
# ADMIN_EMAILS=owner@example.com,ops@example.com
# CLERK_ADMIN_USER_ID=user_replace_me

# Local development storage. Render overrides this with /var/data/slugly.
STORAGE_DIR=./data/storage
STORAGE_SIGNING_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_different_long_random_secret

# Optional integrations
# RESEND_API_KEY=re_replace_me
# TURNSTILE_SECRET_KEY=replace_me
# VITE_TURNSTILE_SITE_KEY=replace_me
# SAFE_BROWSING_API_KEY=replace_me
# SENTRY_DSN=replace_me
# VITE_SENTRY_DSN=replace_me
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_AMPLITUDE_API_KEY=replace_me
